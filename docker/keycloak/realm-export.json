{
  "realm": "justif-dev",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "justif-dev",
      "name": "Justif (dev)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "justif-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/api/auth/oidc/callback",
        "http://localhost:3001/api/auth/oidc/callback"
      ],
      "webOrigins": ["+"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
    }
  ],
  "groups": [
    { "name": "justif-admin" }
  ],
  "requiredActions": [
    {
      "alias": "VERIFY_PROFILE",
      "name": "Verify Profile",
      "providerId": "VERIFY_PROFILE",
      "enabled": false,
      "defaultAction": false,
      "priority": 90,
      "config": {}
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Admin",
      "requiredActions": [],
      "credentials": [{ "type": "password", "value": "password", "temporary": false }],
      "groups": ["/justif-admin"]
    },
    {
      "username": "user",
      "email": "user@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "User",
      "requiredActions": [],
      "credentials": [{ "type": "password", "value": "password", "temporary": false }]
    }
  ]
}
