{
  "name": "justif",
  "version": "0.2.3",
  "private": true,
  "description": "Justif - gestion de notes de frais open source et auto-hébergeable",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "build": "pnpm -r run build",
    "lint": "oxlint . && oxfmt .",
    "format": "oxfmt .",
    "test": "pnpm --parallel -r run test",
    "db:migrate": "pnpm --filter backend run db:migrate",
    "db:generate": "pnpm --filter backend run db:generate",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.78.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
