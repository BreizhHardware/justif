# ── Auth ──────────────────────────────────────
JWT_SECRET=change_me_in_production_min_32_chars

# ── Default Currency ─────────────────────────
DEFAULT_CURRENCY=EUR

# ── Unified docker image ───────────────────────
# Unique port for the backend and frontend, to be used in docker-compose
PORT=3000

# ── Backend ─
DATABASE_URL=file:./db/justif.db
UPLOAD_DIR=./uploads

# ── Deployment ──────────────────────────────────
# For production, you should set the following environment variable to your domain name (For CORS)
NEXT_PUBLIC_API_URL=https://your-domain.example
# Required to send password reset emails
APP_URL=https://your-domain.example

# ── Email (SMTP) ─────────────────────────────────
# Used to send password reset emails. Can also be configured from the admin
# Settings screen, which takes precedence over these defaults.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Justif <no-reply@your-domain.example>