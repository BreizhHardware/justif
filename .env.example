# ── Auth ──────────────────────────────────────
# REQUIRED: the backend refuses to start with a missing/short/placeholder secret.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change_me_in_production_min_32_chars

# Set to true when served over HTTPS so session cookies get the Secure flag.
# COOKIE_SECURE=true
# Number of proxies in front of the backend, used to read the client IP (audit log).
# Docker image: 1 by default (its internal proxy); set 2 behind your own reverse proxy.
# Bare `pnpm dev`/direct run: leave unset, or 1 behind a single reverse proxy.
# SECURITY: with a value > 1 the client IP is taken from X-Forwarded-For, which a client can
# forge if it can reach the container directly. Only set it when the app port is reachable
# solely through your reverse proxy (private docker network / bind to 127.0.0.1). The audit
# log IP and the login rate-limit both rely on it.
# TRUST_PROXY=2

# ── Default Currency ─────────────────────────
DEFAULT_CURRENCY=EUR

# ── Unified docker image ───────────────────────
# Unique port for the backend and frontend, to be used in docker-compose
PORT=3000

# ── Backend ─
DATABASE_URL=file:./db/justif.db
UPLOAD_DIR=./uploads

# ── Deployment ──────────────────────────────────
# For production, you should set the following environment variable to your domain name (For CORS)
NEXT_PUBLIC_API_URL=https://your-domain.example
# Required to send password reset emails
APP_URL=https://your-domain.example

# ── Email (SMTP) ─────────────────────────────────
# Used to send password reset emails. Can also be configured from the admin
# Settings screen, which takes precedence over these defaults.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Justif <no-reply@your-domain.example>

# ── Single sign-on (OIDC) ────────────────────────
# Optional: lets users log in via your company's identity provider (Entra ID /
# Azure AD, Okta, Keycloak, Google Workspace...) instead of (or in addition
# to) a local password. Can also be configured from the admin Settings
# screen, which takes precedence over these defaults.
# Register this instance's callback URL with your identity provider:
#   ${APP_URL}/api/auth/oidc/callback
# OIDC_ISSUER_URL=https://login.example.com/your-tenant
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid email profile
# Claim used to read group membership, for the group -> role mapping
# configurable on the Roles admin screen.
# OIDC_GROUPS_CLAIM=groups